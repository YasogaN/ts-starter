{
  "name": "ts-starter",
  "version": "0.0.0",
  "private": false,
  "description": "",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsup && pnpm build:dts",
    "build:js": "tsup",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly && cp dist/index.d.ts dist/index.d.cts",
    "dev": "tsup --watch",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "knip": "knip",
    "audit": "pnpm audit --audit-level high",
    "pubcheck": "publint && attw --pack",
    "preflight": "pnpm check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size && pnpm knip && pnpm pubcheck",
    "postinstall": "lefthook install --force"
  },
  "size-limit": [
    {
      "name": "esm",
      "path": "dist/index.js",
      "import": "{ sum, ok, err }",
      "limit": "1 kB"
    },
    {
      "name": "cjs",
      "path": "dist/index.cjs",
      "limit": "1 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@arethetypeswrong/cli": "0.18.5",
    "knip": "6.31.0",
    "lefthook": "2.1.10",
    "publint": "0.3.23",
    "size-limit": "13.0.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
